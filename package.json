{
  "name": "puppeteer-wrapper",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "app/server.js",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "API_URL=http://localhost:3000 vitest run tests/api.test.js --config vitest.e2e.config.js",
    "test:watch": "vitest",
    "start": "node app/server.js",
    "dev": "nodemon app/server.js",
    "debug": "node --inspect app/server.js",
    "build:docker:arm": "docker build --platform linux/amd64 . -t render",
    "run:docker:arm": "docker run --platform linux/amd64 -p 3000:3000 render",
    "build:docker": "docker build . -t bakney/fastrender",
    "run:docker": "docker run -p 3000:3000 bakney/fastrender"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7",
    "generic-pool": "^3.9.0",
    "pino": "^10.4.0",
    "puppeteer": "^25.16.0",
    "puppeteer-screen-recorder": "3.0.6",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "nodemon": "^3.1.11",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "fluent-ffmpeg": {
      "async": "3.2.6"
    }
  }
}
